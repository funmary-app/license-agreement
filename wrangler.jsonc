{
	// 外部の人の PR で、ライセンスへの同意を求める Worker。URL は workers.dev (本番のドメインを公開しない)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "funmary-license-agreement",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-02",
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "funmary-license-agreement",
			// wrangler d1 create funmary-license-agreement で作った ID に置き換える (秘密ではない)
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
		},
	],
	// 秘密の値。wrangler secret put で置く (README.md を参照)
	"secrets": {
		"required": [
			"GITHUB_APP_ID",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"SIGNING_KEY",
		],
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true },
	},
}
