{
	"name": "license-agreement",
	"private": true,
	"type": "module",
	"description": "Funmary のリポジトリで、外部の人の PR にライセンスへの同意を求める Cloudflare Worker",
	"license": "(BSD-3-Clause OR Apache-2.0)",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:check": "wrangler deploy --dry-run --outdir dist",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"hono": "^4.13.12"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.145.0"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"commit-msg": "pnpm exec commitlint --edit \"$1\""
	},
	"lint-staged": {
		"*.{js,ts,json,json5,md,yml,yaml,jsonc}": "prettier --write"
	}
}
